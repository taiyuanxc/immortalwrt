CONFIG_TARGET_ipq60xx=y
CONFIG_TARGET_ipq60xx_generic=y
CONFIG_TARGET_ipq60xx_generic_DEVICE_zn_m2=y
CONFIG_LINUX_5_15=y

# 彻底关闭WiFi
CONFIG_PACKAGE_kmod-ath11k=y is not set
CONFIG_PACKAGE_kmod-qca-wifi=y is not set
CONFIG_PACKAGE_wpad-full=y is not set
CONFIG_PACKAGE_wpad-mini=y is not set
CONFIG_PACKAGE_ath11k-firmware=y is not set

# NSS硬件加速
CONFIG_PACKAGE_nss-firmware=y
CONFIG_PACKAGE_kmod-nss=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

# 三件套
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-fs=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_istoreos-custom=y

# 基础网络优化
CONFIG_PACKAGE_luci-theme-design=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y

# 禁用冗余
CONFIG_PACKAGE_vsftpd=y is not set
CONFIG_PACKAGE_samba4=y is not set
CONFIG_PACKAGE_docker=y is not set
